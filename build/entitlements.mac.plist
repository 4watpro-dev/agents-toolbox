<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Moteur JavaScript de Chromium : il compile du code à la volée. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Signature ad hoc, sans équipe Apple : le framework Electron doit pouvoir se charger. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Pas de allow-dyld-environment-variables : aucune bibliothèque injectée par DYLD_INSERT_LIBRARIES. -->
</dict>
</plist>
