{
  "name": "agent-toolbox",
  "productName": "Agent Toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Boîte à outils d'agents IA flottante pour macOS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-app-icon.mjs",
    "app": "electron-vite build && electron-builder --mac --dir && rm -rf \"/Applications/Agent Toolbox.app\" && ditto \"dist/mac-arm64/Agent Toolbox.app\" \"/Applications/Agent Toolbox.app\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.agenttoolbox.app",
    "productName": "Agent Toolbox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
